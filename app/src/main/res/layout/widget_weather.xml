<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weatherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_time_bg"
    android:layoutDirection="rtl"
    android:padding="12dp">

    <ImageView
        android:id="@+id/weatherArt"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/widget_weather_name"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_cloud" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weatherKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mza"
            android:text="دما"
            android:textColor="#B3F7F7FB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/weatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mza"
            android:text="—"
            android:textColor="#F7F7FB"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weatherPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mza"
            android:text="موقعیت"
            android:textColor="#C8F7F7FB"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
